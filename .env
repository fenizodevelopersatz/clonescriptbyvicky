# Local dev environment (gitignored -- never committed). Fill VITE_CONTACT_API_URL
# in with your real form-submission endpoint; see .env.example for what each var does.
# Points at MAIL/sendMail.php served locally via `php -S localhost:8800` from the MAIL folder
# (or the "mail-server" launch.json config in the Browser pane).
VITE_CONTACT_API_URL=http://localhost:8800/sendMail.php
# VITE_CONTACT_API_URL=https://theclonescript.com/mail/sendMail.php
VITE_CONTACT_API_ENABLED=true
VITE_USD_TO_INR=83
