# Local dev environment (gitignored -- never committed). Fill VITE_CONTACT_API_URL
# in with your real form-submission endpoint; see .env.example for what each var does.
# Points at MAIL/sendMail.php served locally via `php -S 0.0.0.0:8800 -t MAIL`.
# Uses the same LAN IP as the Vite dev server (started with --host 0.0.0.0) rather
# than localhost: this machine's browser preview tooling reaches the dev server via
# its LAN address, not loopback, so the mail server has to be reachable the same way.
# VITE_CONTACT_API_URL=http://192.168.29.18:8800/sendMail.php
VITE_CONTACT_API_URL=https://theclonescript.com/mail/sendMail.php
VITE_CONTACT_API_ENABLED=true
VITE_USD_TO_INR=83
