# URL of your endpoint that receives contact-form submissions as JSON POST payloads.
# Must accept CORS requests from this site's origin, or the browser will block the request.
# Local dev: MAIL/sendMail.php (this repo) served via `php -S localhost:8800 -t MAIL`,
# e.g. VITE_CONTACT_API_URL=http://localhost:8800/sendMail.php
VITE_CONTACT_API_URL=

# Set to "false" to temporarily stop forms from sending without a code change.
# Any other value (or leaving it unset) keeps sending enabled.
VITE_CONTACT_API_ENABLED=true

# USD-to-INR exchange rate used to convert every plan price (and the cart)
# when a shopper switches the footer currency selector to Indian Rupee.
# Falls back to 83 in code if left unset.
VITE_USD_TO_INR=83
